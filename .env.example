# PostgreSQL (Docker Compose)
POSTGRES_DB=sql_detective
POSTGRES_USER=sql_detective
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Spring Boot datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sql_detective
SPRING_DATASOURCE_USERNAME=sql_detective
SPRING_DATASOURCE_PASSWORD=change_me

# Read-only player query datasource
SPRING_READONLY_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sql_detective
SPRING_READONLY_DATASOURCE_USERNAME=sql_detective_readonly
SPRING_READONLY_DATASOURCE_PASSWORD=sql_detective_readonly

# Query execution limits
APP_QUERY_STATEMENT_TIMEOUT_MS=2000
APP_QUERY_MAX_ROWS=100

# API
SERVER_PORT=8080
